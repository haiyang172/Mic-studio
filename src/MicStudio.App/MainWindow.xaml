<Window x:Class="MicStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mic Studio" Icon="Assets/mic-studio.ico" Width="1280" Height="820" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Grid Background="{DynamicResource Bg}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel x:Name="BrandHeader" DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,24,14,24"><Image x:Name="BrandIcon" Source="Assets/mic-studio.png" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Mic Studio"/><StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Brand" Text="Mic Studio" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="BrandCaption" Visibility="Collapsed"/></StackPanel></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,18"><TextBlock x:Name="SideCaption" Visibility="Collapsed"/><TextBlock x:Name="SideVersion" Text="0.3.0" FontSize="11" Foreground="{DynamicResource SidebarInk}"/></StackPanel>
    <StackPanel x:Name="Navigation"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,15,16,7">
    <WrapPanel VerticalAlignment="Center">
     <StackPanel Margin="0,0,12,8"><TextBlock x:Name="InputDeviceLabel" Text="输入设备" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,5"/><ComboBox x:Name="InputPicker" Width="310" DisplayMemberPath="DisplayName" ToolTip="按端点 ID 保存。"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock x:Name="ModeLabel" Text="处理方式" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,5"/><ComboBox x:Name="ModePicker" Width="174"><ComboBoxItem Content="系统输入 · APO"/><ComboBoxItem Content="虚拟输入 · CABLE"/></ComboBox></StackPanel>
     <StackPanel Margin="0,0,0,8"><TextBlock x:Name="EffectLabel" Text="效果" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,5"/><Button x:Name="BypassButton" Content="效果开关：开" Padding="13,8" Margin="0" ToolTip="控制增益、EQ 和声音效果；与麦克风静音分开。"/></StackPanel>
    </WrapPanel>
   </Border>
   <Border Grid.Row="1" Background="{DynamicResource NoticeBg}" x:Name="NoticeBar" Visibility="Collapsed" Padding="24,10"><DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="8,0" Margin="8,0,0,0" Click="DismissNotice"/><TextBlock x:Name="NoticeText" Foreground="{DynamicResource Accent}"/></DockPanel></Border>
   <ScrollViewer Grid.Row="2" x:Name="PageScroll" Padding="28,24,24,24"><StackPanel x:Name="PageContent"/></ScrollViewer>
   <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,10" Background="{DynamicResource SidebarBg}"><WrapPanel><TextBlock x:Name="CaptureFooter" Text="已停止" Foreground="{DynamicResource SidebarInk}" FontSize="12" Margin="0,0,22,2"/><TextBlock x:Name="ConfigFooter" Text="设置已就绪" Foreground="{DynamicResource SidebarInk}" FontSize="12" Margin="0,0,22,2"/><TextBlock x:Name="DiscordFooter" Visibility="Collapsed"/></WrapPanel></Border>
  </Grid>
 </Grid>
</Window>
