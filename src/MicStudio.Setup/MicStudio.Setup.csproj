<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <AssemblyName>MicStudio.Setup</AssemblyName><RootNamespace>MicStudio.Setup</RootNamespace><Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Mic Studio native per-user installer</Description>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup Condition="'$(PayloadZip)' != '' and Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="MicStudio.Setup.Payload.zip" />
  </ItemGroup>
  <Target Name="RequirePayloadForPublish" BeforeTargets="Publish" Condition="'$(PayloadZip)' == '' or !Exists('$(PayloadZip)')">
    <Error Text="Publishing MicStudio.Setup requires -p:PayloadZip=absolute-path-to-portable-app.zip" />
  </Target>
</Project>
